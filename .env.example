PORT=4000

# Neon Postgres pooled connection string.
DATABASE_URL=

# Required. The server refuses to boot without it — there is deliberately no
# fallback, because a default secret in a public repo lets anyone forge an
# admin token. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Comma-separated list of browser origins allowed to call this API.
# localhost is added automatically outside production.
ALLOWED_ORIGINS=https://your-staff-app.vercel.app

# Only used by scripts/init-db.js when seeding demo accounts.
# Change every seeded password after the first login.
SEED_PASSWORD=
